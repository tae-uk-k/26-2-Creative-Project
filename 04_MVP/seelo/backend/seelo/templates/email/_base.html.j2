<!doctype html>
<html lang="ko">
<head><meta charset="utf-8"><title>{{ subject }}</title></head>
<body style="margin:0;padding:24px;background:#f5f3ed;font-family:'Apple SD Gothic Neo','Malgun Gothic',sans-serif;color:#242c29;">
<table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;">
  <tr><td style="padding:28px 32px 8px;font-size:24px;font-weight:700;color:#285b46;">seelo</td></tr>
  {% for lines in paragraphs %}
  <tr><td style="padding:8px 32px;font-size:15px;line-height:1.7;">{% for line in lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
  {% endfor %}
  {% if link %}
  <tr><td style="padding:16px 32px;"><a href="{{ link }}" style="display:inline-block;padding:12px 20px;background:#285b46;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;">seelo에서 보기</a></td></tr>
  {% endif %}
  <tr><td style="padding:16px 32px 28px;font-size:12px;color:#626b65;">— seelo<br>이 메일은 발신 전용이에요.</td></tr>
</table>
</body>
</html>
