# 배포 대상에서 별도 파일로 복사하고 채운다. 이 파일은 실행용 비밀 값이 아니다.
# SEELO_ENV_FILE은 그 파일의 절대 경로. --env-file에도 같은 경로를 준다.
SEELO_ENV_FILE=
SEELO_IMAGE_TAG=
PUBLIC_HOST=
TLS_CERT_DIR=
SEELO_PROXY_SUBNET=
POSTGRES_PASSWORD=
# DB 호스트 db, 포트 5432, DB·사용자 seelo. 비밀번호의 URL 예약 문자는 인코딩한다.
DATABASE_URL=
QUEUE_DATABASE_DSN=
SECRET_KEY=
EMAIL_HMAC_KEY=
MAIL_TOKEN_FERNET_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=
MAIL_FROM=
ADMIN_NOTIFY_EMAILS=
GOOGLE_PLACES_API_KEY=
KAKAO_REST_API_KEY=
NAVER_API_KEY_ID=
NAVER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MEASURE_MODEL=
GEMINI_MEASURE_MODEL=
OPENAI_CHEAP_MODEL=
OPENAI_PLAN_MODEL=
# 0은 기존 API 측정 코드에서 무제한이다. 호출 차단 값이 아니다.
DAILY_COST_LIMIT_USD=
AI_BACKEND=api
LOCAL_AI_SOCKET=
LOCAL_AI_SOCKET_DIR=
LOCAL_AI_TOKEN=
LOCAL_AI_TIMEOUT_S=240
AI_REPEAT_COUNT=10
AI_CONCURRENCY_PER_PROVIDER=5
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# 연결 해제 웹훅: 대표 어드민 키 원문을 넣지 않고 SHA-256 비교값만 넣는다.
# 데이터 보존/복구 정책 확인 및 제공자 등록 전에는 둘 다 빈 값 유지.
KAKAO_APP_ID=
KAKAO_UNLINK_ADMIN_KEY_SHA256=
AUTO_FIX_ENABLED=false
KAKAO_FIX_ENABLED=false
GOOGLE_FIX_MODE=browser
SEELO_GOOGLE_ACCOUNT_EMAIL=
SEELO_KAKAO_ACCOUNT_ID=
SENTRY_DSN=
BACKUP_DIR=
BACKUP_KEEP_DAYS=7
UPTIME_URL=
