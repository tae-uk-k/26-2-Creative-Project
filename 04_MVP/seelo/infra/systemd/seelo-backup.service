[Unit]
Description=seelo validated database backup and private export
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=SEELO_ENV_FILE=/etc/seelo/production.env
Environment=SEELO_COMPOSE_FILE=/opt/seelo/current/docker-compose.prod.yml
Environment=BACKUP_DIR=/var/backups/seelo
ExecStart=/usr/bin/flock --nonblock /run/seelo-backup.lock /bin/sh /opt/seelo/current/infra/scripts/backup.sh
ExecStartPost=/usr/bin/python3 /usr/local/lib/seelo/export-backups.py

[Install]
WantedBy=multi-user.target
