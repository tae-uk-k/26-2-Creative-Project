# seelo 환경변수(01 4장, 16 4장). 복사해서 .env로 쓰고 비밀 값은 새로 만든다.
# --- 앱 ---
APP_ENV=dev
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
SENTRY_DSN=
FAKE_EXTERNALS=true
FAKE_MAP_BEHAVIOR=normal

# --- DB·큐 ---
# 로컬 실행(uv run ...)용 주소. Compose 컨테이너 안에서는 docker-compose.yml이 db 호스트로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://seelo:seelo@127.0.0.1:5432/seelo
QUEUE_DATABASE_DSN=postgresql://seelo:seelo@127.0.0.1:5432/seelo

# --- 보안(운영에서 반드시 새로 만든다) ---
SECRET_KEY=change-me-32-bytes-or-more
EMAIL_HMAC_KEY=change-me-and-never-rotate
MAIL_TOKEN_FERNET_KEY=
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12

# --- OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# --- 지도·검색 ---
GOOGLE_PLACES_API_KEY=
KAKAO_REST_API_KEY=
NAVER_API_KEY_ID=
NAVER_API_KEY=
NAVER_LOCAL_SEARCH_URL=https://naverapihub.apigw.ntruss.com/search/v1/local
NAME_SIMILARITY_THRESHOLD=85
COMPETITOR_FACTS_ENABLED=true
WEBSITE_USER_AGENT=SeeloBot/1.0 (+https://example.com/bot)

# --- AI(D-09) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MEASURE_MODEL=
GEMINI_MEASURE_MODEL=
OPENAI_CHEAP_MODEL=
OPENAI_PLAN_MODEL=
AI_CONCURRENCY_PER_PROVIDER=5
AI_REPEAT_COUNT=10
DAILY_COST_LIMIT_USD=0
PRICING_FILE=config/pricing.json
SNAPSHOT_RETENTION_DAYS=30

# --- 메일(D-08) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=seelo <no-reply@example.com>
ADMIN_NOTIFY_EMAILS=

# --- 정비 ---
AUTO_FIX_ENABLED=false
GOOGLE_FIX_MODE=browser
KAKAO_FIX_ENABLED=true
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
GBP_VALIDATE_ONLY=false
BROWSER_PROFILE_DIR_GOOGLE=/data/browser/google
BROWSER_PROFILE_DIR_KAKAO=/data/browser/kakao
BROWSER_HEADLESS=true
SEELO_GOOGLE_ACCOUNT_EMAIL=
SEELO_KAKAO_ACCOUNT_ID=

# --- 인스타그램(W-03-5) ---
INSTAGRAM_BUSINESS_DISCOVERY_ENABLED=false
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=
