  "shortenedCopy": [
    {
      "id": "562:228",
      "before": "AI가 새로운\n가게 탐색 경로가 됐다.",
      "after": "가게 탐색의\n새 경로가 된 AI"
    },
    {
      "id": "562:230",
      "before": "미국 AI 여행계획 이용자\n명소·식당·숨은 장소 탐색 및\n방문 시기 조사",
      "after": "미국 AI 여행계획 이용자\n장소·방문 시기 탐색에 활용"
    },
    {
      "id": "562:234",
      "before": "사장님은 여러 채널의 정보를\n직접 점검하고 수정하기 어렵다.",
      "after": "여러 채널 정보를\n직접 점검·수정하기 어렵다."
    },
    {
      "id": "562:259",
      "before": "검색 노출이 비슷한 가게도\nGEO 정보 상태에 따른\nAI 추천 수 차이가 존재한다.",
      "after": "검색 노출이 비슷해도\nGEO 정보 상태에 따라\nAI 추천 수는 다르다."
    },
    {
      "id": "562:261",
      "before": "AI 추천 등장률 · 매장 집단 간 비교",
      "after": "정보 상태별 AI 추천 등장률"
    }
  ],
